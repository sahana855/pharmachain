# PharmaChain Environment Variables
# Copy this file to .env.local and fill in real values

# Server
PORT=41837
NODE_ENV=development

# MongoDB (REQUIRED)
PHARMACHAIN_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# JWT Authentication (REQUIRED in production)
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-chars
JWT_EXPIRES_IN=7d

# Public base URL for QR code URLs (used in production deployment)
# PUBLIC_BASE_URL=https://your-app.vercel.app

# Blockchain (optional - falls back to hash-chain)
# BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# BLOCKCHAIN_CONTRACT_ADDRESS=

# Email (optional - for OTP login codes)
# MAILER_SERVICE=gmail
# MAILER_HOST=smtp.gmail.com
# MAILER_PORT=587
# MAILER_USER=your@email.com
# MAILER_PASS=your-app-password
# MAILER_FROM=PharmaChain <noreply@pharmachain.com>

# Demo login bypass (development only)
ALLOW_DEMO_LOGIN=false

# Rate limiting
API_RATE_LIMIT_MAX=10000
AUTH_RATE_LIMIT_MAX=30
VERIFY_RATE_LIMIT_MAX=20